# Copy this file to .env (and set the same keys as Netlify build environment
# variables for production) after creating your Firebase project.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and config

REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Optional — only if Google Analytics is enabled for the Firebase project.
REACT_APP_FIREBASE_MEASUREMENT_ID=

# The one owner account's email (must match the Firebase Auth user you create
# manually in the console — this is used client-side for UI gating only; the
# real enforcement lives in firestore.rules / storage.rules).
REACT_APP_ADMIN_EMAIL=
